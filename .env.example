# Secreto usado para cifrar las contraseñas (si no se define se usa "default-parcial")
SEED=
# Ruta del archivo SQLite
DB_PATH=data/app.sqlite
# Orígenes permitidos para CORS, separados por coma (vacío = cualquiera)
# CORS_ORIGIN=http://localhost:3000
# Carpeta donde se guardan las imágenes subidas (POST /uploads)
UPLOADS_DIR=uploads
# Muestra en consola cada petición (método, ruta, status, duración)
# LOG_REQUESTS=true
# Puerto del servidor (por defecto 8080)
# PORT=8080
